<?xml version="1.0" ?>

<sdf version="1.8">

  <model name="test_environment">

    <static>true</static>


    <!-- ====================================================== -->
    <!-- Ground                                                 -->
    <!-- ====================================================== -->

    <link name="ground">

      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>30 30</size>
          </plane>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>30 30</size>
          </plane>
        </geometry>

        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Front wall                                             -->
    <!-- ====================================================== -->

    <link name="front_wall">

      <pose>4.0 0.0 1.0 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 5.0 2.0</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 5.0 2.0</size>
          </box>
        </geometry>

        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Left box                                               -->
    <!-- ====================================================== -->

    <link name="left_box">

      <pose>1.5 1.2 0.5 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.8 1.0</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.8 0.8 1.0</size>
          </box>
        </geometry>

        <material>
          <ambient>1.0 0.4 0.05 1</ambient>
          <diffuse>1.0 0.4 0.05 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Right box                                              -->
    <!-- ====================================================== -->

    <link name="right_box">

      <pose>2.0 -1.2 0.4 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 0.6 0.8</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 0.6 0.8</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.7 0.2 1</ambient>
          <diffuse>0.1 0.7 0.2 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Cylinder                                               -->
    <!-- ====================================================== -->

    <link name="cylinder">

      <pose>-1.5 1.3 0.6 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.6 0.1 0.8 1</ambient>
          <diffuse>0.6 0.1 0.8 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>