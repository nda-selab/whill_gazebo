<?xml version="1.0" ?>

<sdf version="1.8">

  <model name="four_wheel_robot">

    <!-- ====================================================== -->
    <!-- Base link                                              -->
    <!-- ====================================================== -->

    <link name="base_link">

      <inertial>
        <mass>25.0</mass>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.60 0.45 0.12</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.60 0.45 0.12</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Front left wheel                                       -->
    <!-- ====================================================== -->

    <link name="front_left_wheel">

      <pose>
        0.20 0.25 -0.06 -1.5708 0 0
      </pose>

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Front right wheel                                      -->
    <!-- ====================================================== -->

    <link name="front_right_wheel">

      <pose>
        0.20 -0.25 -0.06 -1.5708 0 0
      </pose>

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Rear left wheel                                        -->
    <!-- ====================================================== -->

    <link name="rear_left_wheel">

      <pose>
        -0.20 0.25 -0.06 -1.5708 0 0
      </pose>

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Rear right wheel                                       -->
    <!-- ====================================================== -->

    <link name="rear_right_wheel">

      <pose>
        -0.20 -0.25 -0.06 -1.5708 0 0
      </pose>

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
        </material>
      </visual>

    </link>


    <!-- ====================================================== -->
    <!-- Wheel joints                                           -->
    <!-- ====================================================== -->

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <!-- ====================================================== -->
    <!-- Sensor link                                            -->
    <!-- ====================================================== -->

    <link name="sensor_link">

      <pose relative_to="base_link">
        0 0 0.20 0 0 0
      </pose>

      <inertial>
        <mass>0.5</mass>
      </inertial>

      <visual name="sensor_visual">

        <geometry>
          <box>
            <size>0.12 0.12 0.08</size>
          </box>
        </geometry>

        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
        </material>

      </visual>


      <!-- ==================================================== -->
      <!-- IMU                                                  -->
      <!-- ==================================================== -->

      <sensor name="imu_sensor" type="imu">

        <always_on>true</always_on>

        <update_rate>200</update_rate>

        <topic>imu</topic>

      </sensor>


      <!-- ==================================================== -->
      <!-- 3D LiDAR                                             -->
      <!-- ==================================================== -->

      <sensor name="lidar_sensor" type="gpu_lidar">

        <pose>
          0 0 0.08 0 0 0
        </pose>

        <topic>lidar</topic>

        <update_rate>10</update_rate>

        <ray>

          <scan>

            <horizontal>
              <samples>512</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>

            <vertical>
              <samples>64</samples>
              <resolution>1</resolution>
              <min_angle>-0.19635</min_angle>
              <max_angle>0.19635</max_angle>
            </vertical>

          </scan>

          <range>
            <min>0.3</min>
            <max>50.0</max>
            <resolution>0.01</resolution>
          </range>

        </ray>

        <always_on>true</always_on>
        <visualize>true</visualize>

      </sensor>

    </link>


    <joint name="sensor_joint" type="fixed">

      <parent>base_link</parent>
      <child>sensor_link</child>

    </joint>


    <!-- ====================================================== -->
    <!-- DiffDrive                                              -->
    <!-- ====================================================== -->

    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <max_linear_acceleration>0.3</max_linear_acceleration>
      <min_linear_acceleration>-0.3</min_linear_acceleration>

      <max_angular_acceleration>0.8</max_angular_acceleration>
      <min_angular_acceleration>-0.8</min_angular_acceleration>

      <topic>cmd_vel</topic>

      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

    </plugin>


    <!-- ====================================================== -->
    <!-- Ground truth pose                                      -->
    <!-- ====================================================== -->

    <plugin
      filename="libignition-gazebo-pose-publisher-system.so"
      name="ignition::gazebo::systems::PosePublisher">

      <publish_link_pose>false</publish_link_pose>

      <publish_visual_pose>false</publish_visual_pose>

      <publish_collision_pose>false</publish_collision_pose>

      <publish_sensor_pose>false</publish_sensor_pose>

      <publish_model_pose>true</publish_model_pose>

      <!-- Fortressではtrueが必要 -->
      <publish_nested_model_pose>true</publish_nested_model_pose>

      <use_pose_vector_msg>true</use_pose_vector_msg>

      <static_publisher>false</static_publisher>

      <update_frequency>50</update_frequency>

    </plugin>

  </model>

</sdf>