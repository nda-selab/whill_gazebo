  <exec_depend>ros_gz_bridge</exec_depend>

  <exec_depend>whill_trajectory_control</exec_depend>
  <exec_depend>whill_exact_replay</exec_depend>
  <exec_depend>whill_experiment_recorder</exec_depend>

</package>